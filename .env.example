# --- LLM ---
# Google Gemini API key. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# --- Web search ---
# Serper.dev API key (Google search). Get one at https://serper.dev/api-key
SERPER_API_KEY=your-serper-key-here

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/   # MongoDB connection string
DB_NAME=company_briefs                   # Database name (created automatically)

# --- Server ---
PORT=4000                                # Port the Express server listens on

# --- Gmail ingestion (READ RecruitSage emails via Gmail API OAuth2) ---
# Create a Google Cloud project, enable Gmail API, make a "Desktop app" OAuth
# client (scope gmail.readonly), then run: node scripts/gmail-auth.js
# Authorize the inbox you read from (ayadav2_be23@thapar.edu).
GMAIL_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token-from-gmail-auth-script

# How RecruitSage emails are detected (single source of truth). Tune once you
# see a real email's sender/subject.
RECRUITSAGE_GMAIL_QUERY=from:recruitsage OR "RecruitSage" OR subject:(recruitment notification)

# Ingestion behaviour
GMAIL_INITIAL_LOOKBACK_DAYS=30   # first run only scans this many days back
GMAIL_POLL_INTERVAL_MINUTES=0    # 0 = manual (Sync button only). e.g. 5 = auto every 5 min
DASHBOARD_COMPANY_LIMIT=5        # how many unique companies the dashboard shows

# --- Telegram notifications (optional) ---
# Bot token from @BotFather; chat id is your user/group id (talk to @userinfobot).
# Leave blank to disable. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional outgoing email (OFF by default) ---
ENABLE_EMAIL_NOTIFICATIONS=false                  # true = also email on new company
GMAIL_SENDER=the-gmail-you-authorized@gmail.com   # only used if the above is true
NOTIFY_EMAIL=ayadav2_be23@thapar.edu              # recipient / your inbox label
