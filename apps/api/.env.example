# RecruitSage v2 API — copy to .env and fill. NEVER commit real secrets.
DATABASE_URL=postgresql+asyncpg://recruitsage:recruitsage@db:5432/recruitsage
REDIS_URL=redis://redis:6379/0

# LLM routing (LiteLLM model strings)
LLM_CHEAP_MODEL=gemini/gemini-2.5-flash
LLM_STRONG_MODEL=gemini/gemini-2.5-pro
EMBEDDING_MODEL=gemini/gemini-embedding-001
GEMINI_API_KEY=

# Web research
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=

# Gmail (Pub/Sub push). Encrypted refresh tokens live in the DB.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/gmail-push
TOKEN_ENCRYPTION_KEY=   # `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`

# Telegram (webhook mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

PUBLIC_BASE_URL=http://localhost:3000
